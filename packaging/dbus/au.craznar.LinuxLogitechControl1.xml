    </method>
    <method name="SelectProfile">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="SelectBank">
      <arg name="bank" type="y" direction="in"/>
    </method>
    <method name="SetManagement">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="SetBypass">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="StartRecording">
